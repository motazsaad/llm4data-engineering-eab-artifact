    {
      "parameters": {
        "jsCode": "const a = $('Fetch Contributors A').all().map(i => i.json);\nconst b = $('Fetch Contributors B').all().map(i => i.json);\n\nconst byLogin = {};\nfor (const row of b) {\n  byLogin[row.login] = row;\n}\n\nconst out = [];\nfor (const row of a) {\n  const other = byLogin[row.login];\n  if (!other) { continue; }\n  out.push({\n    json: {\n      login: row.login,\n      id: row.id,\n      contributions: row.contributions,\n      contributions_other: other.contributions,\n      html_url: row.html_url,\n    },\n  });\n}\n\nreturn out;"
      },
